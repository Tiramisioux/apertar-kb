 | `APERTAR_RT=1` | off | The start script runs Core under `SCHED_FIFO` priority 70 on cores 1 to 3 with the best-effort I/O class (`APERTAR_RT_PRIORITY`, `APERTAR_RT_CPUS` adjust it), as cinemate runs cinepi-raw. Needs `LimitRTPRIO` on the unit: install `config/apertar-core-capture-priority.conf` as a drop-in. |
 | `APERTAR_MEDIA_TUNE=1` | off | Kernel-side knobs for the recording drive through the `apertar-media-tune` root helper (dirty-page cushion, scheduler, queue depth). |
 
diff --git a/src/ApertarCoreApp.cpp b/src/ApertarCoreApp.cpp
index 34687b2..707454c 100644
--- a/src/ApertarCoreApp.cpp
+++ b/src/ApertarCoreApp.cpp
@@ -79,6 +79,24 @@ constexpr uint32_t kWebPreviewMaxWidth = 640;
 constexpr uint32_t kWebPreviewMaxHeight = 360;
 constexpr double kWebPreviewMaxFps = 30.0;
 constexpr int kWebPreviewJpegQuality = 75;
+
+// The web preview's rate while a raw take runs (APERTAR_WEB_PREVIEW_RECORDING_FPS): default the normal 30,
+// 0 = no web preview frames while recording. The downsample for it is the one per-frame image pass left on
+// libcamera's completion thread, so this is the A/B knob for the WebUI-open drops (kb working/dng-chain).
+double webPreviewRecordingFps()
+{
+    static const double fps = []() {
+        const char *text = std::getenv("APERTAR_WEB_PREVIEW_RECORDING_FPS");
+        if (!text || !*text)
+            return kWebPreviewMaxFps;
+        char *end = nullptr;
+        const double parsed = std::strtod(text, &end);
+        if (end == text || *end != '\0' || parsed < 0.0 || parsed > kWebPreviewMaxFps)
+            return kWebPreviewMaxFps;
+        return parsed;
+    }();
+    return fps;
+}
 constexpr size_t kMaxEditableHardwareConfigBytes = 256 * 1024;
 
 std::string resolveExecutablePath(std::initializer_list<const char *> candidates,
@@ -9353,9 +9371,13 @@ void ApertarCoreApp::captureWebPreviewFrame(const PreviewFrameDescriptor &frame)
         return;
 
     // This runs on libcamera's completion thread. Camera stop/reconfigure holds
-    // the control mutex while waiting for that thread, so never query it here.
+    // the control mutex while waiting for that thread, so never query it here
+    // (rawTakeActive reads one atomic).
+    const double maxFps = camera_.rawTakeActive() ? webPreviewRecordingFps() : kWebPreviewMaxFps;
+    if (maxFps <= 0.0)
+        return;
     const auto minInterval = std::chrono::microseconds(
-        static_cast<int64_t>(1'000'000.0 / kWebPreviewMaxFps));
+        static_cast<int64_t>(1'000'000.0 / maxFps));
     const auto now = std::chrono::steady_clock::now();
     {
         std::lock_guard<std::mutex> lock(mjpegMutex_);
diff --git a/src/camera/CameraController.cpp b/src/camera/CameraController.cpp
index c41765c..20f517e 100644
--- a/src/camera/CameraController.cpp
+++ b/src/camera/CameraController.cpp
@@ -11978,6 +11978,11 @@ bool CameraController::cdngLogApplicable() const
 // Called about 5 times a second from the HTTP and watcher threads. The numbers come from the write queue's
 // lock-free gauge. Only the mode needs the controller's settings, so it is read under try_lock: while the
 // command path holds the mutex (including the whole drain after a take stops) the last answer is reused.
+bool CameraController::rawTakeActive() const
+{
+    return frameBufferGauge().active.load(std::memory_order_acquire);
+}
+
 CameraController::FrameBufferStatus CameraController::frameBufferStatus() const
 {
     FrameBufferGauge &gauge = frameBufferGauge();
