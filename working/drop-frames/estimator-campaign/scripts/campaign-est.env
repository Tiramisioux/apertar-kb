# Estimator day settings (copy of the NVMe campaign.env, write cap 16 TB, User 2026-11-11), read by start-est.sh via CAMPAIGN_ENV.
# One run directory for the whole campaign: one database, one ledger of clips, DONE-<stage> markers per stage.
RUN=$HOME/longtakes/nvme-20261110
MODES=4kHDR16,4kSDR12,4kHDR12
START_FPS=4kHDR16=28,4kSDR12=meter,4kHDR12=30
BUDGET_GB=16000
EXPECT_SERIAL=A936B442006AC2
# Pre-registered die rolls (plan section 7): ABBA order per lever, and the mode order of S5 / S6 / Part B.
ABBA=log=AB,web=AB
ORDER_S5=4kHDR16,4kSDR12,4kHDR12
ORDER_S6=4kSDR12,4kHDR16,4kHDR12
# Crops: none, 16:9 only (Patrik 2026-11-10). Format if ever wanted: 4kC185=3840x2076:12
CROPS=
# Extra runner arguments for every night. No drive-recovery idles: shoot on like a shoot, with a 10-min break every hour (User 2026-11-10); the merge wait stays
EXTRA="--idle-between 0 --cold-wait 0 --cooldown-every 3600 --cooldown-s 600 --audio-optional"
