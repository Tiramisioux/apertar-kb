# NVMe 4K campaign settings, read by start-night.sh (copied to ~/nvme-campaign/campaign.env on the Pi).
# One run directory for the whole campaign: one database, one ledger of clips, DONE-<stage> markers per stage.
RUN=$HOME/longtakes/nvme-20261110
MODES=4kHDR16,4kSDR12,4kHDR12
START_FPS=4kHDR16=28,4kSDR12=meter,4kHDR12=30
BUDGET_GB=10000
EXPECT_SERIAL=A936B442006AC2
# Pre-registered die rolls (plan section 7): ABBA order per lever, and the mode order of S5 / S6 / Part B.
ABBA=log=AB,web=AB
ORDER_S5=
ORDER_S6=
# Crops from S0's list_sensor_modes probe (H17), e.g. 4kC185=3840x2076:12,4kC239=3840x1608:12 (empty = none yet)
CROPS=
# Extra runner arguments for every night (e.g. --audio-ms 1000 once the audio lever is armed)
EXTRA=
