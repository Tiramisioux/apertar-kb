+    // A Favorite stores no Clear HDR (the preset's is the camera's now), only a size and a bit
+    // depth: Clear HDR is 4K only and has the only 16-bit mode, so 4K 12-bit is either class,
+    // 16-bit Clear HDR, the rest SDR. It matches the ladder in a class that keeps both.
+    const auto namedAs = [&](bool clearHdr) {
+        CaptureSettings asNamed = preset;
+        asNamed.clearHdr = clearHdr;
+        return ladderRungOf(sanitizeSettingsForSensor(asNamed, sensorFamily));
+    };
