+    if (dryRun) {
+        lastError_.clear();
+        return true;
+    }
+    if (recording_) {
+        setErrorLocked("Stop recording before changing the Mode Ladder.");
+        return false;
+    }
+    // Errors refuse a save; turning the ladder off is always possible.
+    if (!reply.errors.empty() && (rungs || draft.enabled)) {
+        std::string message;
+        for (const auto &error : reply.errors)
+            message += (message.empty() ? "" : " ") + error;
+        setErrorLocked(message);
+        return false;
+    }
