+// T34: the ladder picks the resolution: switched on, raw video, at least one usable resolution.
+bool CameraController::ladderActiveForLocked(const CaptureSettings &base) const
+{
+    return modeLadder_.enabled && ladderRunsIn(base) &&
+           ladder::chooseRung(modeLadder_, ladderStatesLocked(modeLadder_, base, false), 0.0) >= 0;
+}
+
+// T34: put the resolution for next's FPS into next, before the caller's one apply: its mode, its
+// compression where that applies, and the FPS capped at its "Up to". True when that is another
+// mode or compression than next had (applyFpsStepLocked then moves there). Never in a take:
+// resolutions change between takes.
+bool CameraController::ladderRewriteLocked(CaptureSettings &next) const
+{
+    if (recording_ || !ladderActiveForLocked(next))
+        return false;
+    const auto states = ladderStatesLocked(modeLadder_, next, false);
+    const int index = ladder::chooseRung(modeLadder_, states, next.fps);
+    if (index < 0)
+        return false;
+    const SensorFamily sensorFamily = (!simulateCamera_ && session_)
+        ? session_->sensorFamily()
+        : SensorFamily::Unknown;
+    // Compared in Core's identity: after a configure the session reports the active raw size.
+    const ladder::Rung before = ladderRungOf(sanitizeSettingsForSensor(next, sensorFamily));
+    const ladder::Rung &rung = modeLadder_.rungs[static_cast<size_t>(index)];
+    const bool compressionApplies = ladderCompressionApplies(next);
+    next.resolution = Resolution{ rung.width, rung.height };
+    next.rawBitDepth = rung.bits;
+    next.clearHdr = rung.clearHdr;
+    if (compressionApplies)
+        applyLadderCompression(next, rung.compression);
+    next.fps = std::min(next.fps, ladder::rungCeiling(rung, states[static_cast<size_t>(index)]));
+    return !ladder::sameMode(before, rung) || (compressionApplies && before.compression != rung.compression);
+}
