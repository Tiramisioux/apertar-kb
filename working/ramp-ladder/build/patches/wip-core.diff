+    const bool hdrKeeps = hdr.width == sdr.width && hdr.height == sdr.height && (hdr.bits == sdr.bits || hdr.bits == 16);
+    const bool sdrKeeps = !hdrKeeps || hdr.bits == sdr.bits;
+    const ladder::Rung &named = sdrKeeps ? sdr : hdr;  // SDR where both keep it
+    const ladder::Rung runs = ladderRungOf(sanitizeSettingsForSensor(chosen, sensorFamily));
+    if (namesMode && !(sdrKeeps && ladder::sameMode(sdr, runs)) && !(hdrKeeps && ladder::sameMode(hdr, runs))) {
+        setErrorLocked("This Favorite records " + ladder::label(named) + " at " + ladder::number(preset.fps) +
+                       " fps; the Mode Ladder runs " + ladder::number(chosen.fps) + " fps in " + ladder::label(runs) +
+                       ". Turn the ladder off to load it, or save the Favorite again.");
+        return false;
+    }
+    preset = chosen;
+    return true;
+}
