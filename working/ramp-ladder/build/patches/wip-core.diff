+// Mode Ladder (T34). The pure logic is in ModeLadder.hpp; these map between it and CaptureSettings.
+constexpr const char *kLadderPicksMode =
+    "The Mode Ladder picks the resolution from the FPS. Turn it off in Settings > Record > Mode Ladder to choose by hand.";
+constexpr const char *kLadderSetsCompression =
+    "The Mode Ladder sets the compression of each resolution. Turn it off in Settings > Record > Mode Ladder to choose by hand.";
+
+// The compression cDNG and lossy DNG record with; None in the other formats.
+ladder::Compression ladderCompressionOf(const CaptureSettings &settings)
+{
+    if (settings.recordingFormat == RecordingFormat::LossyDng)
+        return settings.lossyDngRatio == LossyDngRatio::R5 ? ladder::Compression::Lossy5 : ladder::Compression::Lossy3;
+    if (settings.recordingFormat == RecordingFormat::Cdng && settings.cdngCompression == CdngCompression::LosslessJpeg)
+        return ladder::Compression::LosslessJpeg;
+    return ladder::Compression::None;
+}
+
+// None and lossless JPEG are cDNG, the lossy ones lossy DNG (cdngCompression left uncompressed,
+// as a Favorite's lossy compression leaves it). Both share one settings profile.
+void applyLadderCompression(CaptureSettings &settings, ladder::Compression compression)
+{
+    const bool lossy = compression == ladder::Compression::Lossy3 || compression == ladder::Compression::Lossy5;
+    settings.recordingFormat = lossy ? RecordingFormat::LossyDng : RecordingFormat::Cdng;
+    settings.cdngCompression = compression == ladder::Compression::LosslessJpeg
+        ? CdngCompression::LosslessJpeg : CdngCompression::Uncompressed;
+    if (lossy)
+        settings.lossyDngRatio = compression == ladder::Compression::Lossy5 ? LossyDngRatio::R5 : LossyDngRatio::R3;
+}
+
+// The camera's settings as a ladder resolution, without an "Up to".
+ladder::Rung ladderRungOf(const CaptureSettings &settings)
+{
+    ladder::Rung rung;
+    rung.width = settings.resolution.width;
+    rung.height = settings.resolution.height;
+    rung.bits = settings.rawBitDepth;
+    rung.clearHdr = settings.clearHdr;
+    rung.compression = ladderCompressionOf(settings);
+    return rung;
+}
+
+// The ladder runs in raw video (cDNG, lossy DNG, MLV), not in photo mode.
+bool ladderRunsIn(const CaptureSettings &settings)
+{
+    return !settings.photoModeEnabled && (settings.recordingFormat == RecordingFormat::Cdng ||
+        settings.recordingFormat == RecordingFormat::LossyDng || settings.recordingFormat == RecordingFormat::Mlv);
+}
+
+// MLV records uncompressed: there a resolution's compression does not apply.
+bool ladderCompressionApplies(const CaptureSettings &settings)
+{
+    return settings.recordingFormat == RecordingFormat::Cdng || settings.recordingFormat == RecordingFormat::LossyDng;
+}
+
+// The resolution the camera runs, from 0; -1 when it runs none, or one that is skipped now.
+int runningLadderRung(const ladder::Ladder &l, const std::vector<ladder::RungState> &states,
+                      const CaptureSettings &settings)
+{
+    const int index = ladder::findRung(l, ladderRungOf(settings), ladderCompressionApplies(settings));
+    if (index < 0 || static_cast<size_t>(index) >= states.size() ||
+        ladder::rungCeiling(l.rungs[static_cast<size_t>(index)], states[static_cast<size_t>(index)]) <= 0.0)
+        return -1;
+    return index;
+}
+
+// ladder_text while the ladder is active: the running line, or what the next FPS pick does.
+std::string ladderRunningText(const ladder::Ladder &l, const std::vector<ladder::RungState> &states, int running,
+                              const CaptureSettings &settings, const ladder::Crop &area)
+{
+    if (running < 0)
+        return "Mode Ladder on · the next FPS pick chooses the resolution";
+    const size_t i = static_cast<size_t>(running);
+    const ladder::Rung &rung = l.rungs[i];
+    return ladder::runningText(i, rung, ladder::rungCeiling(rung, states[i]), ladder::cropIn(states[i].crop, area),
+                               ladderCompressionApplies(settings) ? ladder::compressionLabel(rung.compression) : "MLV");
+}
+
+// A probed size in Core's identity: the readouts 3840x2200 (16-bit Clear HDR) and 3856x2180 are
+// 4K, 1928x1090 is 1920x1080.
+Resolution ladderSizeOf(const Resolution &size)
+{
+    if (isImx585HighResolutionAlias(size))
+        return Resolution{ 3840, 2160 };
+    if (isImx585LowResolutionAlias(size))
+        return Resolution{ 1920, 1080 };
+    return size;
+}
+
+// A probed mode's sensor window. A mode folded to Core's identity keeps the window's origin but
+// no more than the identity's size (times the binning): 4K, not the taller readout with its
+// optical-black rows, so the readout area is 3840x2160 and every 4K mode fills it.
+ladder::Crop ladderCropOf(const CameraController::SensorMode &mode)
+{
+    ladder::Crop crop;
+    if (!ladder::parseCrop(mode.crop, crop))
+        return crop;
+    const Resolution size = ladderSizeOf(mode.size);
+    if (!resolutionMatches(size, mode.size.width, mode.size.height)) {
+        const uint32_t binning = std::max<uint32_t>(mode.binning, 1);
+        crop.width = std::min(crop.width, size.width * binning);
+        crop.height = std::min(crop.height, size.height * binning);
+    }
+    return crop;
+}
+
+// The probed sensor modes the editor may add, in Core's identity (ladderSizeOf), once each: Clear
+// HDR first, then by width, height and bit depth, so 4K, the crops by height and the binned modes
+// follow in that order.
+std::vector<ladder::PoolEntry> ladderPoolModes(const std::vector<CameraController::SensorMode> &modes)
+{
+    std::vector<ladder::PoolEntry> pool;
+    for (const auto &mode : modes) {
+        if (mode.bitDepth != 10 && mode.bitDepth != 12 && mode.bitDepth != 16)
+            continue;                   // a rung is 10, 12 or 16 bits
+        const Resolution size = ladderSizeOf(mode.size);
+        ladder::PoolEntry entry;
+        entry.mode.width = size.width;
+        entry.mode.height = size.height;
+        entry.mode.bits = mode.bitDepth;
+        entry.mode.clearHdr = mode.clearHdr;
+        const auto seen = [&](const ladder::PoolEntry &other) { return ladder::sameMode(other.mode, entry.mode); };
+        if (std::any_of(pool.begin(), pool.end(), seen))
+            continue;
+        entry.crop = ladderCropOf(mode);
+        entry.binning = mode.binning;
+        pool.push_back(entry);
+    }
+    std::stable_sort(pool.begin(), pool.end(), [](const ladder::PoolEntry &a, const ladder::PoolEntry &b) {
+        if (a.mode.clearHdr != b.mode.clearHdr)
+            return a.mode.clearHdr;
+        if (a.mode.width != b.mode.width)
+            return a.mode.width > b.mode.width;
+        if (a.mode.height != b.mode.height)
+            return a.mode.height > b.mode.height;
+        return a.mode.bits > b.mode.bits;
+    });
+    return pool;
+}
+
+// The probed mode a resolution runs in (its crop and binning), matched as probedMaximumFps matches.
+std::optional<CameraController::SensorMode> probedSensorModeFor(SensorFamily sensorFamily, const ladder::Rung &rung)
+{
+    const SensorModeSelection mode = sensorModeForRequestedResolution(
+        sensorFamily, Resolution{ rung.width, rung.height }, rung.bits);
+    std::lock_guard<std::mutex> lock(probedSensorModesMutex);
+    for (const auto &probed : probedSensorModes) {
+        if (probed.clearHdr == rung.clearHdr && probed.bitDepth == mode.bitDepth &&
+            resolutionMatches(probed.size, mode.rawResolution.width, mode.rawResolution.height))
+            return probed;
+    }
+    return std::nullopt;
+}
+
+// The readout area the crop diagrams are drawn in: the extent of every probed crop (ladderCropOf).
+ladder::Crop probedSensorArea()
+{
+    std::vector<ladder::Crop> crops;
+    std::lock_guard<std::mutex> lock(probedSensorModesMutex);
+    for (const auto &mode : probedSensorModes)
+        crops.push_back(ladderCropOf(mode));
+    return ladder::sensorArea(crops);
+}
