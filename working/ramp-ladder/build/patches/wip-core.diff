+// T34: the derived FPS ceilings and ladder_* fields of `out`, a copy of settings_ (or settings_).
+void CameraController::fillLadderFieldsLocked(CaptureSettings &out) const
+{
+    out.fpsMax = out.fpsTakeMax = fpsMaxLocked();
+    out.ladderEnabled = modeLadder_.enabled;
+    out.ladderActive = false;
+    out.ladderRung = 0;
+    out.ladderCount = static_cast<uint32_t>(modeLadder_.rungs.size());
+    out.ladderText.clear();
+    out.ladderTops.clear();
+    if (!ladderActiveForLocked(out))
+        return;
+    const SensorFamily sensorFamily = (!simulateCamera_ && session_)
+        ? session_->sensorFamily()
+        : SensorFamily::Unknown;
+    const auto states = ladderStatesLocked(modeLadder_, out, false);
+    out.ladderActive = true;
+    out.fpsMax = ladder::ladderCeiling(modeLadder_, states);
+    for (size_t i = 0; i < states.size(); ++i)
+        out.ladderTops.push_back(ladder::rungCeiling(modeLadder_.rungs[i], states[i]));
+    // In Core's identity: after a configure the session reports the active raw size.
+    const int running = runningLadderRung(modeLadder_, states, sanitizeSettingsForSensor(out, sensorFamily));
+    out.ladderText = ladderRunningText(modeLadder_, states, running, out, probedSensorArea());
+    if (running >= 0) {
+        out.ladderRung = static_cast<uint32_t>(running + 1);
+        out.fpsTakeMax = out.ladderTops[static_cast<size_t>(running)];
+    }
+}
