+    else if (!state.usable)
+        state.reason = "Not available in this format.";
+    if (const auto mode = probedSensorModeFor(sensorFamily, rung)) {
+        state.crop = ladderCropOf(*mode);
+        state.binning = mode->binning;
+    }
+    return state;
+}
