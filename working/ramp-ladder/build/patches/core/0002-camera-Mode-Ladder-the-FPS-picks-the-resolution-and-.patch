+    probe.photoModeEnabled = false;
+    probe.resolution = Resolution{ rung.width, rung.height };
+    probe.rawBitDepth = rung.bits;
+    probe.clearHdr = rung.clearHdr;
+    probe.fps = 280.0;                  // ask for the most; the sanitiser answers the ceiling
+    CaptureSettings reference = probe;  // a mode of this sensor at all: uncompressed cDNG keeps it
+    applyLadderCompression(reference, ladder::Compression::None);
+    if (ownCompression || ladderCompressionApplies(base))
+        applyLadderCompression(probe, rung.compression);
+
+    const CaptureSettings kept = sanitizeSettingsForSensor(probe, sensorFamily);
+    const char *unsupported = unsupportedRecordingSettings(probe);
+    ladder::RungState state;
+    state.valid = ladder::sameMode(ladderRungOf(sanitizeSettingsForSensor(reference, sensorFamily)), rung);
+    state.usable = state.valid && !unsupported && ladder::sameMode(ladderRungOf(kept), rung) &&
+        kept.recordingFormat == probe.recordingFormat && ladderCompressionOf(kept) == ladderCompressionOf(probe);
+    state.modeCeiling = state.valid ? kept.fps : 0.0;
+    if (!state.valid)
+        state.reason = "Not a mode of this sensor.";
+    else if (unsupported)
