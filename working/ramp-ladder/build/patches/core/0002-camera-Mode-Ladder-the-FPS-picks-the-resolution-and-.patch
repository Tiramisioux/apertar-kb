+// Mode Ladder (T34). The pure logic is in ModeLadder.hpp; these map between it and CaptureSettings.
+constexpr const char *kLadderPicksMode =
+    "The Mode Ladder picks the resolution from the FPS. Turn it off in Settings > Record > Mode Ladder to choose by hand.";
+constexpr const char *kLadderSetsCompression =
+    "The Mode Ladder sets the compression of each resolution. Turn it off in Settings > Record > Mode Ladder to choose by hand.";
+
+// The compression cDNG and lossy DNG record with; None in the other formats.
+ladder::Compression ladderCompressionOf(const CaptureSettings &settings)
+{
+    if (settings.recordingFormat == RecordingFormat::LossyDng)
+        return settings.lossyDngRatio == LossyDngRatio::R5 ? ladder::Compression::Lossy5 : ladder::Compression::Lossy3;
+    if (settings.recordingFormat == RecordingFormat::Cdng && settings.cdngCompression == CdngCompression::LosslessJpeg)
+        return ladder::Compression::LosslessJpeg;
+    return ladder::Compression::None;
+}
+
+// None and lossless JPEG are cDNG, the lossy ones lossy DNG (cdngCompression left uncompressed,
+// as a Favorite's lossy compression leaves it). Both share one settings profile.
+void applyLadderCompression(CaptureSettings &settings, ladder::Compression compression)
+{
+    const bool lossy = compression == ladder::Compression::Lossy3 || compression == ladder::Compression::Lossy5;
+    settings.recordingFormat = lossy ? RecordingFormat::LossyDng : RecordingFormat::Cdng;
+    settings.cdngCompression = compression == ladder::Compression::LosslessJpeg
+        ? CdngCompression::LosslessJpeg : CdngCompression::Uncompressed;
+    if (lossy)
+        settings.lossyDngRatio = compression == ladder::Compression::Lossy5 ? LossyDngRatio::R5 : LossyDngRatio::R3;
+}
+
+// The camera's settings as a ladder resolution, without an "Up to".
+ladder::Rung ladderRungOf(const CaptureSettings &settings)
+{
+    ladder::Rung rung;
+    rung.width = settings.resolution.width;
+    rung.height = settings.resolution.height;
+    rung.bits = settings.rawBitDepth;
+    rung.clearHdr = settings.clearHdr;
+    rung.compression = ladderCompressionOf(settings);
+    return rung;
+}
