+std::vector<ladder::RungState> CameraController::ladderStatesLocked(const ladder::Ladder &l,
+                                                                    const CaptureSettings &base,
+                                                                    bool ownCompression) const
+{
+    std::vector<ladder::RungState> states;
+    for (const auto &rung : l.rungs)
+        states.push_back(rungStateLocked(rung, base, ownCompression));
+    return states;
+}
