+// T34: what the sanitiser makes of one resolution, starting from `base`. ownCompression: in the
+// resolution's own compression (validation, the pool); else as the camera would run it now, so
+// in MLV with MLV's ceilings.
+ladder::RungState CameraController::rungStateLocked(const ladder::Rung &rung, const CaptureSettings &base,
+                                                    bool ownCompression) const
+{
+    const SensorFamily sensorFamily = (!simulateCamera_ && session_)
+        ? session_->sensorFamily()
+        : SensorFamily::Unknown;
