+// T34: the mode_ladder reply for `l`, the saved ladder or a draft, against the current settings.
+ladder::Reply CameraController::ladderReplyLocked(const ladder::Ladder &l) const
+{
+    const SensorFamily sensorFamily = (!simulateCamera_ && session_)
+        ? session_->sensorFamily()
+        : SensorFamily::Unknown;
+    ladder::Reply reply;
+    reply.ladder = l;
+    reply.states = ladderStatesLocked(l, settings_, false);
+    reply.active = l.enabled && ladderRunsIn(settings_) && ladder::chooseRung(l, reply.states, 0.0) >= 0;
+    reply.format = toString(settings_.recordingFormat);
+    reply.compressionApplies = ladderCompressionApplies(settings_);
+    reply.buildMax = buildMaximumFps.load();
+    reply.area = probedSensorArea();
+    if (reply.active) {
+        reply.running = runningLadderRung(l, reply.states, sanitizeSettingsForSensor(settings_, sensorFamily));
+        reply.runningText = ladderRunningText(l, reply.states, reply.running, settings_, reply.area);
+    }
+    reply.pool = ladderPoolModes(sensorModes());
+    for (auto &entry : reply.pool) {
+        for (size_t k = 0; k < ladder::kCompressions.size(); ++k) {
+            ladder::Rung mode = entry.mode;
+            mode.compression = ladder::kCompressions[k];
+            const ladder::RungState state = rungStateLocked(mode, settings_, true);
+            entry.valid = state.valid;
+            entry.ceilings[k] = state.usable ? state.modeCeiling : 0.0;
+            entry.reasons[k] = state.reason;
+        }
+    }
+
+    // Errors and warnings in each resolution's own compression, so the same in every format.
+    const auto own = ladderStatesLocked(l, settings_, true);
+    ladder::validate(l, own, reply.errors, reply.warnings);
+    // Core's notes.
+    const auto any = [&](auto test) { return std::any_of(l.rungs.begin(), l.rungs.end(), test); };
+    if (settings_.recordingFormat == RecordingFormat::Mlv)
+        reply.warnings.push_back("MLV records uncompressed: each resolution's compression applies in cDNG and lossy DNG.");
+    if (sensorFamily == SensorFamily::Imx585 &&
+        any([](const ladder::Rung &r) { return r.compression == ladder::Compression::LosslessJpeg; }))
+        reply.warnings.push_back("Lossless JPEG caps ISO at 800 on this sensor.");
+    if (ladderRunsIn(settings_)) {
+        const char *format = settings_.recordingFormat == RecordingFormat::Mlv ? "MLV" : "CinemaDNG";
+        for (size_t i = 0; i < l.rungs.size(); ++i)
+            if (own[i].usable && !reply.states[i].usable)
+                reply.warnings.push_back(ladder::resolutionName(i) + " is skipped in " + format + ": " +
+                                         reply.states[i].reason);
+    }
+    if (!settings_.tuningFile.empty() && any([](const ladder::Rung &r) { return r.clearHdr; }) &&
+        any([](const ladder::Rung &r) { return !r.clearHdr; }))
+        reply.warnings.push_back("A manual tuning file is set; it is used for both Clear HDR and SDR.");
+    return reply;
+}
