+void CameraController::setBuildMaximumFps(double fps)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    buildMaximumFps.store(fps > 0.0 ? fps : 0.0);
+    // Before start (and in standby) the session's own sanitise applies it; a take
+    // keeps its rate, the next set_fps after it is capped.
+    if (state_ != CameraState::Ready || recording_)
+        return;
+    const double capped = fpsMaxLocked();
+    if (settings_.fps > capped + 0.0001) {
+        std::cerr << "ApertarCore build maximum: " << settings_.fps << " -> " << capped << " fps\n";
+        applyFpsStepLocked(capped, /*rampingTake=*/false, /*commit=*/true);
+        return;
+    }
+    emitSettingsEventLocked();
+}
+
+// What the sanitiser leaves of 280 fps in the current settings.
+double CameraController::fpsMaxLocked() const
+{
+    const SensorFamily sensorFamily = (!simulateCamera_ && session_)
+        ? session_->sensorFamily()
+        : SensorFamily::Unknown;
+    CaptureSettings probe = settings_;
+    probe.fps = 280.0;
+    return sanitizeSettingsForSensor(probe, sensorFamily).fps;
+}
