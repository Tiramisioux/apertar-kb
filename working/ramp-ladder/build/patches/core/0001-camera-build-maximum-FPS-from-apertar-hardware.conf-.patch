+// [camera] max_fps, the build maximum (CameraController::setBuildMaximumFps).
+// 0 = no build limit: no file, no key, empty, or not a number in 0 < fps <= 280.
+double cameraMaxFpsFromHardwareConfig()
+{
+    std::error_code ec;
+    for (const auto &path : hardwareConfigCandidatePaths()) {
+        if (!std::filesystem::exists(path, ec) || !std::filesystem::is_regular_file(path, ec))
+            continue;
+        std::ifstream input(path);
+        if (!input.is_open())
+            continue;
+        bool inSection = false;
+        double maxFps = 0.0;
+        std::string line;
+        while (std::getline(input, line)) {
+            std::string trimmed = trimAscii(line);
+            if (trimmed.empty() || trimmed[0] == '#' || trimmed[0] == ';')
+                continue;
+            if (trimmed.front() == '[' && trimmed.back() == ']') {
+                inSection = lowerAscii(trimmed) == "[camera]";
+                continue;
+            }
+            if (!inSection)
+                continue;
+            const std::size_t eq = trimmed.find('=');
+            if (eq == std::string::npos || lowerAscii(trimAscii(trimmed.substr(0, eq))) != "max_fps")
+                continue;
+            const std::string value = trimmed.substr(eq + 1);
+            const auto parsed = parseDoubleValue(value.substr(0, value.find('#')));
+            maxFps = parsed && *parsed > 0.0 && *parsed <= 280.0 ? *parsed : 0.0;
+        }
+        return maxFps;
+    }
+    return 0.0;
+}
