+                    << timecodeAtBase(event.appliedFrameIndex);
+            else
+                out << "- - - -";
+            out << ' ' << event.bootUs << ' ' << event.fromFps << ' ' << event.toFps << ' '
+                << event.shutterUs << '\n';
+        }
+    }
