 // only on its next frame, and the UI never. 1 s idle, 250 ms while recording.
 // This thread holds no lock anyone else waits for while it probes, so a probe
 // that blocks on a hung device blocks only this thread.
+// Speed ramping (T31): step the FPS from its current value to targetFps over
+// `seconds` on a helper thread, one set_fps per whole frame per second, the way
+// Cinemate's _ramp_fps walks 1 fps every 0.2 s. seconds == 0 jumps in one step.
+// The thread ends at the first refused step (ramping off, H.264 take, limit).
+bool ApertarCoreApp::startFpsRamp(double targetFps, double seconds, std::string *error)
+{
+    stopFpsRamp();
+    const double fromFps = camera_.settings().fps;
+    if (std::abs(targetFps - fromFps) < 0.0005) {
+        if (error) *error = "FPS is already at the requested value.";
+        return false;
+    }
+    if (seconds <= 0.0) {
+        if (!camera_.setFps(targetFps)) {
+            if (error) *error = camera_.lastError();
+            return false;
+        }
+        return true;
+    }
+    if (camera_.isRecording()) {
+        // Refuse now, as seconds == 0 does through setFps(), instead of answering ok
+        // and logging the refusal from the helper thread on its first step.
+        const CaptureSettings current = camera_.settings();
+        if (!current.fpsRampEnabled) {
+            if (error) *error = "Stop recording before changing FPS, or enable FPS ramping (set_fps_ramp) for cDNG/MLV takes.";
+            return false;
+        }
+        if (current.photoModeEnabled || current.recordingFormat == RecordingFormat::H264 ||
+            current.recordingFormat == RecordingFormat::Prores) {
+            if (error) *error = "FPS ramping works in cDNG and MLV takes only.";
+            return false;
+        }
+    }
+    fpsRampStop_.store(false);
+    fpsRampThreadActive_.store(true);
+    const bool takeScoped = camera_.isRecording();
+    fpsRampThread_ = std::thread([this, fromFps, targetFps, seconds, takeScoped] {
+        const int steps = std::max(1, std::min(200, static_cast<int>(std::lround(std::abs(targetFps - fromFps)))));
+        const auto interval = std::chrono::microseconds(static_cast<int64_t>(seconds * 1000000.0 / steps));
+        double lastFps = fromFps;
+        for (int step = 1; step <= steps; ++step) {
+            {
+                // A condition variable, not a sleep: stopFpsRamp() must return at once
+                // (record_start and record_stop call it under the command lock).
+                std::unique_lock<std::mutex> lock(fpsRampMutex_);
+                if (fpsRampCv_.wait_for(lock, interval, [this] { return fpsRampStop_.load(); }))
+                    break;
+            }
+            const double fps = step == steps ? targetFps : fromFps + (targetFps - fromFps) * step / steps;
+            if (!camera_.setFps(std::round(fps * 1000.0) / 1000.0, takeScoped)) {
+                std::cerr << "ApertarCore fps ramp stopped: " << camera_.lastError() << "\n";
+                break;
+            }
+            // The sanitiser clamps to the mode's ceiling at acceptance, so a step
+            // that did not move the setting is the end of the road, not a lag.
+            const double acceptedFps = camera_.settings().fps;
+            if (std::abs(acceptedFps - lastFps) < 0.0005) {
+                std::cerr << "ApertarCore fps ramp stopped: " << acceptedFps << " fps is this mode's limit\n";
+                break;
+            }
+            lastFps = acceptedFps;
+        }
+        fpsRampThreadActive_.store(false);
+    });
+    return true;
+}
+
+void ApertarCoreApp::stopFpsRamp()
+{
+    {
+        std::lock_guard<std::mutex> lock(fpsRampMutex_);
+        fpsRampStop_.store(true);
+    }
+    fpsRampCv_.notify_all();
+    if (fpsRampThread_.joinable())
+        fpsRampThread_.join();
+    fpsRampThreadActive_.store(false);
+}
