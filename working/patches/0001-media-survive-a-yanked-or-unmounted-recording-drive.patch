+namespace {
+std::string mediaEventJson(const MediaSnapshot &snapshot)
+{
+    std::ostringstream out;
+    out << "{\"event\":\"media\",\"state\":\"" << snapshot.stateName() << "\""
+        << ",\"mounted\":" << (snapshot.mounted() ? "true" : "false")
