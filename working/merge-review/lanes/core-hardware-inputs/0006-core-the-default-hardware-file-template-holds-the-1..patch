From 44165a35168c40c270be3e7479449c15c55acc3e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 09:51:05 +0000
Subject: [PATCH] core: the default hardware file template holds the 1.6.0
 touch UI's input and network sections

Why: in Apertar 1.6.0 a fresh camera got its hardware file from the
touch UI (ensureDefaultHardwareConfigFile, src/DisplayConfigBridge.cpp:
41-326 in UI upstream-1.6.0), with [network], input tuning and knob
mappings. The port deleted that writer and Core is to write the first
file from its own template, which lacked [network], chip=, the input
tuning keys, the NeoRotary and Grove mappings, and still named the
buttons' section [gpio].

What: the template gains, with the 1.6.0 file's values: [network]
hotspot_delay_seconds=60; [pcf8574] active_low, poll_ms, debounce_ms;
[neorotary4] poll_ms, debounce_ms, invert_direction, reset_on_start,
max_events_per_poll and the twelve encoder mappings; [gpio] becomes
[gpio_buttons] with chip=auto, active_low, pull, poll_ms=12,
debounce_ms=60; [grove_analog] tuning and the a0/a1 mappings. Kept as
comments: the d5/d6 button and encoder0 examples (they claim GPIO 5
and 6 twice) and no shared keys in [gpio_encoders] (its poll_ms=3 and
debounce_ms=40 would override the buttons' lines); pin0..7=none is
left out (the reader's default). [ina219] stays enabled. [display] is
unchanged (touch UI's), the IMU sections follow.

Tested: check_core.sh both builds and the 18 host tests pass. A
scratch program ran hwconf::validate over the template: 0 issues with
empty facts and with buses 0 1 4 10 13 14; it parses back byte for
byte. A key-by-key comparison with the 1.6.0 UI file leaves only the
exceptions above, the IMU sections and [display]. --simulate with no
file: GET /api/config shows the text, 0 errors and 0 warnings, the GPIO
card's chip is auto. KB controls_test section 13 passes. Pi: none until
Core writes the file.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NEFc1w7Y8dcyiV489BiwMr
---
 src/ApertarCoreApp.cpp | 61 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 58 insertions(+), 3 deletions(-)

diff --git a/src/ApertarCoreApp.cpp b/src/ApertarCoreApp.cpp
index 76c0479..1e7a5a8 100644
--- a/src/ApertarCoreApp.cpp
+++ b/src/ApertarCoreApp.cpp
@@ -5039,6 +5039,11 @@ std::string defaultHardwareConfigTemplate()
 # INA219 I2C bus example: /dev/i2c-4 -> bus=4
 # Address can be decimal or hex.
 
+[network]
+# Hotspot fallback wait in seconds (0-86400); 0 removes the delay.
+# An established Wi-Fi connection is left alone. Restart apertar-network.service after changes.
+hotspot_delay_seconds=60
+
 [ina219]
 enabled=true
 bus=4
@@ -5130,6 +5135,9 @@ sync_offset_ms=0
 enabled=false
 bus=1
 address=0x20
+active_low=true
+poll_ms=40
+debounce_ms=60
 # A pin that reads pressed when Core starts is ignored until released; true takes it as a normally closed (1-0-1) button.
 # invert_on_start=false
 
@@ -5139,20 +5147,57 @@ address=0x20
 enabled=false
 bus=1
 address=0x49
-
-[gpio]
+poll_ms=30
+debounce_ms=60
+invert_direction=false
+reset_on_start=false
+max_events_per_poll=8
+encoder0_cw=iso_up
+encoder0_ccw=iso_down
+encoder0_press=iso
+encoder1_cw=shutter_up
+encoder1_ccw=shutter_down
+encoder1_press=shutter
+encoder2_cw=wb_up
+encoder2_ccw=wb_down
+encoder2_press=wb
+encoder3_cw=fps_up
+encoder3_ccw=fps_down
+encoder3_press=resolution
+
+[gpio_buttons]
 # GPIO button actions use the same names as [pcf8574].
+# Grove digital ports use the BCM number printed on the Grove Base HAT, for example D5 -> d5.
 # Example: d17=recindicatorled reserves GPIO17 as the recording LED output.
 enabled=false
+# chip=auto is the Pi's 40-pin header; another chip by path, for example /dev/gpiochip13.
+chip=auto
+active_low=true
+pull=up
+poll_ms=12
+debounce_ms=60
 # A button that reads pressed when Core starts is ignored until released; true takes it as a normally closed (1-0-1) button.
 # invert_on_start=false
+# Example buttons (GPIO 5 and 6 are also the pins of the [gpio_encoders] example):
+# d5=capture
+# d6=eject
 
 [gpio_encoders]
 # Optional direct GPIO / Grove incremental rotary encoders. Press, cw and ccw actions use the names of [pcf8574].
+# For Grove Encoder, connect SIGA/SIGB to the two configured digital pins.
+# chip, active_low, pull, poll_ms and debounce_ms are shared with [gpio_buttons]: set them there.
 enabled=false
+# Example encoder:
+# encoder0_a=5
+# encoder0_b=6
+# encoder0_cw=iso_up
+# encoder0_ccw=iso_down
+# encoder0_press_gpio=13
+# encoder0_press=iso
+# encoder0_steps_per_event=4
 
 [gpio_switches]
-# Optional two- and three-way switches on GPIO pins, read like [gpio] (chip, pull, active_low, debounce_ms).
+# Optional two- and three-way switches on GPIO pins; chip, pull, active_low and debounce_ms come from [gpio_buttons].
 # Two-way: switch0_pins=17, switch0_on=..., switch0_off=...
 # Three-way: switch1_pins=22,23, switch1_position0=... (22 closed), switch1_position1=... (middle), switch1_position2=... (23 closed)
 # The position a switch is in is applied when Core starts.
@@ -5160,9 +5205,19 @@ enabled=false
 
 [grove_analog]
 # Optional Grove Base HAT analog controls: potentiometers, sliders, rotary angle sensors.
+# ADC address is usually 0x04 on STM32 HATs and 0x08 on newer MM32 HATs.
 enabled=false
 bus=1
 address=0x04
+poll_ms=80
+deadband=32
+emit_on_start=false
+a0=wb
+a0_min=2500
+a0_max=8000
+a0_step=50
+a1=iso
+a1_mode=preset
 
 [trigger_output]
 # Optional capture trigger pulse for DIY hot shoe, flash sync, tally, or accessories.
-- 
