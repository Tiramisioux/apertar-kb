From b08bd7540c54b0b7ca89f9801a6c73cd8e323c91 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 04:50:02 +0000
Subject: [PATCH] core, web: a config text save names its revision only to be
 refused when stale

Why: POST /api/config refused a browser save that sent no X-Apertar-Revision
header with a 409 "old_page" code, telling an Origin header apart from a
script, and answered other refusals through errorReplyBody with a code, a
revision and issue and conflict lists. The page branched on that code. In
1.6.0 the route saves the text over the current file and refuses only with
errorReply(-1, sentence) (ApertarCoreApp.cpp:7175-7195@upstream-1.6.0; WEB-5).
A header beside a raw body is upstream's own shape (x-preset-filename,
ApertarCoreApp.cpp:7396-7400@upstream-1.6.0), so the revision header stays.

What: a save without the header is taken against the current revision for
every client, as in 1.6.0; with it, a stale save is refused. Refusals are
errorReply(-1, sentence) with their status kept (409 for stale, locked,
being written, conflict and merge review; 400 otherwise). The page shows
Core's sentence and keeps the text in the box. controlsConflictsJson lost
its last caller and is removed.

Tested: check_core.sh both builds and 18 host tests pass. --simulate: curl
without the header saves, with -H 'Origin: ...' too; a stale header gives
409 and the sentence; an empty body gives 400. Chromium, two tabs: the
second save is refused with Core's sentence, its text stays, the file keeps
tab one's save. smoke + shape_subset: every 1.6.0 field present with the
same type. Camera: nothing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NEFc1w7Y8dcyiV489BiwMr
---
 src/ApertarCoreApp.cpp     | 32 +++-----------------------------
 src/web/WebControlPage.cpp | 17 ++++-------------
 2 files changed, 7 insertions(+), 42 deletions(-)

diff --git a/src/ApertarCoreApp.cpp b/src/ApertarCoreApp.cpp
index c56b0c1..ba7b509 100644
--- a/src/ApertarCoreApp.cpp
+++ b/src/ApertarCoreApp.cpp
@@ -4998,21 +4998,6 @@ std::string controlsIssuesJson(const std::vector<hwconf::Issue> &issues)
     return out.str();
 }
 
-std::string controlsConflictsJson(const std::vector<hwconf::Conflict> &conflicts)
-{
-    std::ostringstream out;
-    out << '[';
-    for (size_t i = 0; i < conflicts.size(); ++i) {
-        const hwconf::Conflict &conflict = conflicts[i];
-        out << (i > 0 ? "," : "") << "{\"section\":\"" << escapeJson(conflict.section) << "\""
-            << ",\"key\":\"" << escapeJson(conflict.key) << "\""
-            << ",\"base\":\"" << escapeJson(conflict.base) << "\""
-            << ",\"current\":\"" << escapeJson(conflict.current) << "\"}";
-    }
-    out << ']';
-    return out.str();
-}
-
 std::string controlsReplacedJson(const hardware::ReplacedInfo &replaced)
 {
     std::ostringstream out;
@@ -8608,16 +8593,10 @@ WebServer::Response ApertarCoreApp::handleWebRequest(const WebServer::Request &r
             return response;
         }
 
-        // The page names the revision it loaded. A browser without one is a tab from before the update; a script
-        // (no Origin) keeps last-writer-wins.
+        // The page names the revision it loaded, to be refused when the file is newer. Without it the text is
+        // saved over the current file, as in 1.6.0.
         hardware::HardwareConfigStore &store = hardware::configStore();
         const auto revisionHeader = request.headers.find("x-apertar-revision");
-        if (revisionHeader == request.headers.end() && request.headers.count("origin")) {
-            response.status = 409;
-            response.body = errorReplyBody(-1, "Apertar was updated: reload this page. Your text stays in the box.",
-                                           "\"code\":\"old_page\"");
-            return response;
-        }
         const std::string base = revisionHeader != request.headers.end() ? revisionHeader->second : store.currentRevision();
 
         hardware::StoreFlags flags;
@@ -8627,15 +8606,10 @@ WebServer::Response ApertarCoreApp::handleWebRequest(const WebServer::Request &r
             const bool changed = result.needsReview || result.code == "stale" || result.code == "conflict" ||
                 result.code == "being_written" || result.code == "locked";
             response.status = changed ? 409 : 400;
-            const std::string code = result.needsReview ? "merge_review" : result.code;
             const std::string message = result.needsReview
                 ? "The file changed since you loaded it. Reload; your text stays in the box."
                 : result.error;
-            response.body = errorReplyBody(-1, message,
-                "\"code\":\"" + escapeJson(code) + "\",\"revision\":\"" + escapeJson(result.revision) + "\""
-                ",\"issues\":" + controlsIssuesJson(result.issues) +
-                ",\"new_errors\":" + controlsIssuesJson(result.newErrors) +
-                ",\"conflicts\":" + controlsConflictsJson(result.conflicts));
+            response.body = errorReply(-1, message);
             return response;
         }
         if (result.written) {
diff --git a/src/web/WebControlPage.cpp b/src/web/WebControlPage.cpp
index 88f319b..832b321 100644
--- a/src/web/WebControlPage.cpp
+++ b/src/web/WebControlPage.cpp
@@ -19013,7 +19013,7 @@ std::string_view webControlPageHtml()
       state.configSaveInFlight = true;
       updateConfigEditorControls();
       try {
-        // The revision the text was loaded at: Core refuses a save over a newer file, and an old tab without one.
+        // The revision the text was loaded at: Core refuses a save over a newer file.
         const headers = { "Content-Type": "text/plain; charset=utf-8" };
         if (state.configRevision)
           headers["X-Apertar-Revision"] = state.configRevision;
@@ -19023,11 +19023,8 @@ std::string_view webControlPageHtml()
           body: text,
         });
         const payload = await response.json();
-        if (!payload.ok) {
-          const failure = new Error(payload.error || "Could not save config.");
-          failure.payload = payload;
-          throw failure;
-        }
+        if (!payload.ok)
+          throw new Error(payload.error || "Could not save config.");
         state.configDirty = false;
         const backupNote = payload.backup_display_path ? " Backup: " + payload.backup_display_path + "." : "";
         showToast("Config saved." + backupNote, false);
@@ -19039,13 +19036,7 @@ std::string_view webControlPageHtml()
           showConfigIssues("Saved. Core found " + found.length + (found.length === 1 ? " thing" : " things") + " to look at:", found);
       } catch (error) {
         // A refused save leaves the text in the box (no reload), so nothing typed is lost.
-        const payload = error && error.payload;
-        if (payload) {
-          const found = payload.new_errors && payload.new_errors.length > 0 ? payload.new_errors : payload.issues;
-          const kept = payload.code === "stale" || payload.code === "conflict" || payload.code === "merge_review"
-            ? " Your text stays in the box. Press Reload Config to see the newer file." : "";
-          showConfigIssues(error.message + kept, found);
-        }
+        showConfigIssues(error.message || "Could not save config.", []);
         showToast(error.message || "Could not save config.", true);
       } finally {
         state.configSaveInFlight = false;
-- 
