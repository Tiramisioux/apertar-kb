From de65a8dcd744d35361274e29fa69ccee5baa1da2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 18:52:30 +0000
Subject: [PATCH 4/6] audio: bound the writer queue and size the WAV from bytes
 written

Why:
The port moved the raw PCM write to a writer thread but kept counting
capturedBytes_ in the reader, at enqueue time. After a write failure the
writer drops every block, yet finalizeWav sized the WAV from
capturedBytes_, so the data chunk was shorter than the header said (or
had a silent tail when resampling). The queue also grew without limit
while the medium stalled. Original Apertar adds to capturedBytes_ only
after a successful rawStream_.write (src/audio/AudioRecordingSession.cpp
:472-474 @upstream-1.6.0), and its background DNG writer is bounded by
configuredWriterByteCap() with APERTAR_LOSSYDNG_WRITER_BYTES
(src/lossydng/LossyDngEncoder.cpp:97-110 @upstream-1.6.0).

What:
The writer thread adds each block to capturedBytes_ after it was written,
so finalizeWav and the "no samples" check see only bytes in the raw file.
enqueueWrite refuses a block that would take the backlog above
APERTAR_AUDIO_WRITER_BYTES (default 64 MB, at least 1 MB), read the same
way as the DNG writer cap; it then sets the take failure "Audio capture
write stalled." and writeFailed_, so the reader stops.

Tested:
check_core.sh both tests: both builds pass, no new warnings, 17 host
tests pass. No ALSA here. Needs the Pi: record with audio to a nearly
full card, then ffprobe -v warning <clip>.wav shows no size warning; and
APERTAR_AUDIO_WRITER_BYTES=1048576 with a stalled card ends the take with
"Audio capture write stalled.".

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NEFc1w7Y8dcyiV489BiwMr
---
 src/audio/AudioRecordingSession.cpp | 28 ++++++++++++++++++++++++++--
 src/audio/AudioRecordingSession.hpp |  2 +-
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/audio/AudioRecordingSession.cpp b/src/audio/AudioRecordingSession.cpp
index 8789532..d065a23 100644
--- a/src/audio/AudioRecordingSession.cpp
+++ b/src/audio/AudioRecordingSession.cpp
@@ -25,6 +25,21 @@ namespace {
 
 constexpr uint32_t kBextChunkSize = 602;
 
+size_t configuredWriterByteCap()
+{
+    static const size_t value = [] {
+        const char *env = std::getenv("APERTAR_AUDIO_WRITER_BYTES");
+        if (!env || !*env)
+            return size_t(64) * 1024u * 1024u;
+        char *end = nullptr;
+        const unsigned long long parsed = std::strtoull(env, &end, 10);
+        if (end == env || parsed < 1024ull * 1024ull)
+            return size_t(64) * 1024u * 1024u;
+        return static_cast<size_t>(parsed);
+    }();
+    return value;
+}
+
 void ignoreSigpipeProcessWide()
 {
     static std::once_flag once;
@@ -483,7 +498,6 @@ void AudioRecordingSession::readerLoop()
                 if (audioEndBootUs_ && sampleBootUs > int64_t(audioEndBootUs_) + 10000) {
                     const uint64_t gapBytes = framesForDurationUs(sampleBootUs - audioEndBootUs_, options_.sampleRate) * blockAlign;
                     enqueueWrite(nullptr, static_cast<size_t>(gapBytes));
-                    capturedBytes_ += gapBytes;
                     fitFrames_ += gapBytes / blockAlign;
                     std::cerr << "ApertarCore audio discontinuity: padded_us=" << sampleBootUs - audioEndBootUs_ << "\n";
                 }
@@ -533,7 +547,6 @@ void AudioRecordingSession::readerLoop()
             }
             enqueueWrite(buffer.data(), static_cast<size_t>(bytesRead));
             if (writeFailed_.load(std::memory_order_acquire)) break;
-            capturedBytes_ += static_cast<uint64_t>(bytesRead);
             if (shouldMeasureLevel)
                 emitLevel(meterLevel);
             continue;
@@ -739,6 +752,16 @@ void AudioRecordingSession::enqueueWrite(const char *data, size_t size)
     if (data)
         std::memcpy(block.data(), data, size);
     std::lock_guard<std::mutex> lock(writeMutex_);
+    if (queuedWriteBytes_ + size > configuredWriterByteCap()) {
+        // The medium has stopped taking data: end the take instead of growing
+        // the queue until the memory runs out.
+        if (!writeFailed_.exchange(true, std::memory_order_acq_rel)) {
+            failure_.set("Audio capture write stalled.");
+            std::cerr << "ApertarCore audio writer: backlog above " << configuredWriterByteCap() / (1024u * 1024u)
+                      << " MB, capture stopped\n";
+        }
+        return;
+    }
     writeQueue_.push_back(std::move(block));
     queuedWriteBytes_ += size;
     peakQueuedWriteBytes_ = std::max(peakQueuedWriteBytes_, queuedWriteBytes_);
@@ -777,6 +800,7 @@ void AudioRecordingSession::writerLoop()
             std::cerr << "ApertarCore audio capture write failed.\n";
             continue;
         }
+        capturedBytes_ += static_cast<uint64_t>(block.size());
         if (const auto now = std::chrono::steady_clock::now(); now - lastSync >= syncEvery) {
             lastSync = now;
             rawStream_.flush();
diff --git a/src/audio/AudioRecordingSession.hpp b/src/audio/AudioRecordingSession.hpp
index 29f725e..63d786e 100644
--- a/src/audio/AudioRecordingSession.hpp
+++ b/src/audio/AudioRecordingSession.hpp
@@ -94,7 +94,7 @@ private:
     uint64_t videoLastBootUs_ = 0;
     int64_t videoLastDurationUs_ = 0;
     uint64_t videoEndBootUs_ = 0;
-    uint64_t capturedBytes_ = 0;
+    uint64_t capturedBytes_ = 0;  // bytes in rawStream_; the writer thread counts them
     uint64_t audioEndBootUs_ = 0;
     // Least-squares fit of samples captured against each block's BOOTTIME stamp,
     // for the clock-drift estimate (see finalizeWav).
