From c89dae5980abd2577bd2a7e4fb26b5df21c030dd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 18:38:14 +0000
Subject: [PATCH 2/6] rec: clip-name example reads a listing, never the medium
 under the lock

Why: settings() and emitSettingsEventLocked() filled clip_name_example by
calling std::filesystem::exists for clip 1..9999 until a name was free,
with mutex_ held. That ran on every setter reply and every state poll
(the WebUI polls once a second per client): 400 takes on the card meant
about 400 stat calls per poll, also during a take. On a hung or pulled
USB mount a stat blocks, and record_stop, checkRecordingFailure and every
setter wait on mutex_. Original Apertar looks the clip folder up once,
at take start (DngRecordingQueue::reserveClipFolder), and settings()
does no I/O; nothing slow runs under mutex_ (CAM-10).

What: the media watcher, which already probes the mount root on its own
thread, lists the root's names once per cycle while nothing records and
hands them to CameraController::setClipFolderNames. The example is now
computed under the lock from that set (a lookup, no I/O), so it still
follows the current format, fps and clock at once. nextClipFolderName
takes the "is this name taken" test as a function; the take-start path
keeps probing the medium as before. startRecording adds the take's own
folder to the set, so the example shows the clip after it during the
take. preview_clip_name is unchanged.

Tested: check_core.sh lane-core1 both tests: PASS. --simulate with 400
dummy clip folders: clip_name_example cDNG_..._C0401; a folder made or
removed by hand shows in the next poll; set_record_format mlv answers
MLV_..._C0001 at once; WebUI "Next clip:" line shows the name, no page
errors. strace cannot attach in this container, so the stat count per
poll was not measured here. On the Pi, with many clips and the WebUI
open, pull the card and press record stop: it must answer within 2 s;
and strace -f -c -e trace=newfstatat -p $(pidof apertar-core) for 10 s
of WebUI polling shows no stat per clip folder.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NEFc1w7Y8dcyiV489BiwMr
---
 src/ApertarCoreApp.cpp          | 11 +++++++++
 src/camera/CameraController.cpp | 41 ++++++++++++++++++++++++++-------
 src/camera/CameraController.hpp |  5 ++++
 3 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/src/ApertarCoreApp.cpp b/src/ApertarCoreApp.cpp
index f197b31..c4c9693 100644
--- a/src/ApertarCoreApp.cpp
+++ b/src/ApertarCoreApp.cpp
@@ -10896,6 +10896,17 @@ void ApertarCoreApp::runMediaWatcher()
             mediaSnapshot_ = current;
             mediaSnapshotValid_ = true;
         }
+        // The clip-name example (clip_name_example) is computed from this listing, here on the watcher's own
+        // thread, so a hung medium never blocks the camera lock. Not during a take; nothing on a dead mount.
+        if (!camera_.isRecording()) {
+            std::set<std::string> names;
+            if (current.state == MediaSnapshot::State::Mounted || current.state == MediaSnapshot::State::None) {
+                std::error_code ec;
+                for (std::filesystem::directory_iterator it(options_.mediaRoot, ec), end; !ec && it != end; it.increment(ec))
+                    names.insert(it->path().filename().string());
+            }
+            camera_.setClipFolderNames(std::move(names));
+        }
         // A delete made outside Core (the touch UI removes clips itself) frees space without a trim: when the
         // mounted medium gains 1 GiB or more between two polls while nothing records, ask for one. Core's own
         // deletes already request theirs; repeated requests coalesce (kb working/dng-chain, R4).
diff --git a/src/camera/CameraController.cpp b/src/camera/CameraController.cpp
index f9a0554..145ff5f 100644
--- a/src/camera/CameraController.cpp
+++ b/src/camera/CameraController.cpp
@@ -1187,8 +1187,8 @@ apertar::clipname::Values clipNameValues(const CaptureSettings &settings, const
     return v;
 }
 
-// The folder name for the next take of these settings; no side effects (nothing is created).
-std::string nextClipFolderName(const std::filesystem::path &root, const CaptureSettings &settings,
+// The folder name for the next take of these settings; `exists` says whether a name is taken. Nothing is created.
+std::string nextClipFolderName(const std::function<bool(const std::string &)> &exists, const CaptureSettings &settings,
                                const std::string &sensor, const std::chrono::system_clock::time_point &now)
 {
     using namespace apertar::clipname;
@@ -1196,15 +1196,22 @@ std::string nextClipFolderName(const std::filesystem::path &root, const CaptureS
     if (!parsed.ok)
         parsed = parse(kDefaultTemplate);
     const Values values = clipNameValues(settings, sensor, now);
-    const int clip = nextClipNumber(parsed, values, [&](const std::string &name) {
-        std::error_code ec;
-        return std::filesystem::exists(root / name, ec);
-    });
+    const int clip = nextClipNumber(parsed, values, exists);
     if (clip == 0)
         throw std::runtime_error("Could not allocate a unique clip folder.");
     return expand(parsed, values, clip);
 }
 
+// The same, probing the folders under `root` on the medium.
+std::string nextClipFolderName(const std::filesystem::path &root, const CaptureSettings &settings,
+                               const std::string &sensor, const std::chrono::system_clock::time_point &now)
+{
+    return nextClipFolderName([&](const std::string &name) {
+        std::error_code ec;
+        return std::filesystem::exists(root / name, ec);
+    }, settings, sensor, now);
+}
+
 std::filesystem::path withPhotoExtension(std::filesystem::path basePath, const char *extension)
 {
     basePath += extension;
@@ -11824,16 +11831,27 @@ std::string CameraController::clipNameSensorLocked() const
     return sensorFamilyName(session_->sensorFamily());
 }
 
+// No I/O here: it runs under mutex_ on every settings read and event, so it looks names up in the media
+// watcher's last listing of the root, not on the medium.
 void CameraController::fillClipNameExampleLocked(CaptureSettings &out) const
 {
     try {
-        out.clipNameExample = nextClipFolderName(mediaRootPath(mediaRoot_), out, clipNameSensorLocked(),
-                                                 std::chrono::system_clock::now());
+        out.clipNameExample = nextClipFolderName([this](const std::string &name) {
+            return clipFolderNames_.count(name) > 0;
+        }, out, clipNameSensorLocked(), std::chrono::system_clock::now());
     } catch (const std::exception &) {
         out.clipNameExample.clear();
     }
 }
 
+void CameraController::setClipFolderNames(std::set<std::string> names)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (recording_)
+        return;   // listed before the take began: it lacks the take's folder (startRecording added it)
+    clipFolderNames_ = std::move(names);
+}
+
 bool CameraController::setClipNameTemplate(const std::string &value, std::string *stored)
 {
     std::lock_guard<std::mutex> lock(mutex_);
@@ -12024,6 +12042,13 @@ bool CameraController::startRecording(const AudioRecordingOptions &audioOptions,
     }
 
     if (simulateCamera_) recordingDropWarning_.reset();
+    if (!simulateCamera_) {
+        // The take's folder exists now; the media watcher lists the root again only after the take.
+        CaptureSettings take = settings_;
+        fillClipNameExampleLocked(take);
+        if (!take.clipNameExample.empty())
+            clipFolderNames_.insert(take.clipNameExample);
+    }
     recording_ = true;
     rampTakeBaseFps_ = settings_.fps;
     rampTakeChanged_ = false;
diff --git a/src/camera/CameraController.hpp b/src/camera/CameraController.hpp
