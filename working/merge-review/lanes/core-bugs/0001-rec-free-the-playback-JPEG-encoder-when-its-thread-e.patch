From b3fd1e63ef3f807db4654554e08dd9ff499ef8bd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 18:28:00 +0000
Subject: [PATCH 1/6] rec: free the playback JPEG encoder when its thread ends

Why: encodeRgbJpeg kept a raw thread_local tjhandle from tjInitCompress
and never called tjDestroy. Playback frames are decoded on the web
connection thread, and WebServer starts one detached thread per
connection, so every frame not served from the cache left one TurboJPEG
handle and its libjpeg state behind. Core's memory grew with every scrub
and play session. Original Apertar wraps the handle in
TurboJpegCompressor, whose destructor calls tjDestroy, and keeps it as
thread_local TurboJpegCompressor compressor (ApertarCoreApp.cpp,
encodeYuv420ToJpeg).

What: PlaybackFrames.cpp gets its own copy of that small struct in its
anonymous namespace, under the same APERTARCORE_HAS_TURBOJPEG guard, and
encodeRgbJpeg uses thread_local TurboJpegCompressor compressor. The
handle is now destroyed when the connection thread exits. Encoder
settings are unchanged.

Tested: check_core.sh both builds and host tests pass, no new warnings.
A standalone program with the same encode call on 3000 short-lived
threads: raw handle 4 MB -> 20 MB RSS, with the struct 4 MB -> 6 MB.
Needs the Pi: scrub a 4K clip in the WebUI for 5 minutes and compare
ps -o rss -C apertar-core before and after; growth should stay within
the JPEG caches (about 32 MB).

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NEFc1w7Y8dcyiV489BiwMr
---
 src/playback/PlaybackFrames.cpp | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/src/playback/PlaybackFrames.cpp b/src/playback/PlaybackFrames.cpp
index 7693e91..6b9ca62 100644
--- a/src/playback/PlaybackFrames.cpp
+++ b/src/playback/PlaybackFrames.cpp
@@ -86,16 +86,33 @@ DecodeSlots &slots()
     return s;
 }
 
+#if APERTARCORE_HAS_TURBOJPEG
+struct TurboJpegCompressor {
+    TurboJpegCompressor()
+        : handle(tjInitCompress())
+    {
+    }
+
+    ~TurboJpegCompressor()
+    {
+        if (handle)
+            tjDestroy(handle);
+    }
+
+    tjhandle handle = nullptr;
+};
+#endif
+
 bool encodeRgbJpeg(const std::vector<uint8_t> &rgb, uint32_t width, uint32_t height, int quality, std::vector<uint8_t> &out)
 {
 #if APERTARCORE_HAS_TURBOJPEG
-    thread_local tjhandle handle = tjInitCompress();
-    if (!handle) return false;
+    thread_local TurboJpegCompressor compressor;
+    if (!compressor.handle) return false;
     const unsigned long bound = tjBufSize(int(width), int(height), TJSAMP_420);
     out.resize(bound);
     unsigned char *buffer = out.data();
     unsigned long size = bound;
-    const int rc = tjCompress2(handle, rgb.data(), int(width), 0, int(height), TJPF_RGB, &buffer, &size, TJSAMP_420, quality,
+    const int rc = tjCompress2(compressor.handle, rgb.data(), int(width), 0, int(height), TJPF_RGB, &buffer, &size, TJSAMP_420, quality,
                                TJFLAG_FASTDCT | TJFLAG_NOREALLOC);
     if (rc != 0 || size == 0) { out.clear(); return false; }
     out.resize(size);
